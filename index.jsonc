{
  "name": "@rljson/cars-origin-client",
  "summary": "Client website of the origin side of the cars example app, where catalogs are captured originally: a static page that shows its own hello line and the lines of /api/hello; served by nginx as the container app ca-cars-origin-client-<stage>, which forwards /api to the master of its side.",
  "domain": ["static page in the browser; later syncs with the master of its side and ships as an Electron app", "container cars-origin-client, nginx, uid 1000, port 8080, GET /health"],
  "interfaces": {
    "uses": {
      "cars-origin-master": "GET /api/hello over HTTP at MASTER_URL",
    },
    "usedBy": {},
  },
}
